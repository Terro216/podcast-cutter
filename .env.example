# Telegram bot token from @BotFather
BOT_TOKEN=

# Podcast Index API credentials: https://api.podcastindex.org/signup
PODCAST_API_KEY=
PODCAST_API_SECRET=

# Optional. Defaults to the public Podcast Index endpoint.
PODCAST_API_BASEURL=https://api.podcastindex.org/api/1.0

# Telegram user ids allowed to run /stats, comma-separated. Unset means
# nobody. Send /stats once and the log will tell you your own id.
ADMIN_IDS=

# Optional tuning.
# MAX_CUT_SECONDS=900        # longest interval a user may request
# MAX_CONCURRENT_JOBS=2      # simultaneous ffmpeg jobs across all users
# WORK_DIR=/tmp/podcast-cutter

# Durable state: the SQLite journal and rotating log files. Docker sets this
# to /data and mounts a volume there; without a mount, a redeploy loses both.
# DATA_DIR=data
# Journal rows older than this are deleted at startup. 0 keeps everything.
# LOG_RETENTION_DAYS=90
