# Telegram bot token from @BotFather
BOT_TOKEN=

# Podcast Index API credentials: https://api.podcastindex.org/signup
PODCAST_API_KEY=
PODCAST_API_SECRET=

# Required: raw 256-bit SQLCipher key for /data/podcast_cutter.db.
# Generate once with: openssl rand -hex 32
# Keep it unchanged across deploys and restores. By deliberate pet-project
# policy, the complete .env is also stored beside the encrypted DB inside the
# encrypted restic snapshot.
DATABASE_KEY=

# Optional. Defaults to the public Podcast Index endpoint.
PODCAST_API_BASEURL=https://api.podcastindex.org/api/1.0

# Feed ids disabled after a publisher/rightsholder request, comma-separated.
# Empty is the public-beta default. This is a takedown control, not proof that
# every unlisted podcast granted a licence.
PODCAST_BLOCKLIST=

# Versioned user acceptance and public legal pages. Bump TERMS_VERSION when a
# material change must be accepted again. The defaults point at this public
# repository; override them if the project moves.
TERMS_VERSION=2026-08-18
LEGAL_BASE_URL=https://github.com/Terro216/podcast-cutter/blob/main/docs
LEGAL_CONTACT=podcast_cutter@inbox.ru

# Telegram user ids allowed to run /stats, comma-separated. Unset means
# nobody. Send /stats once and the log will tell you your own id.
ADMIN_IDS=

# Optional tuning.
# MAX_CUT_SECONDS=900        # longest interval a user may request
# MAX_SOURCE_SECONDS=21600   # longest episode this bot will open at all

# Proxy for the Telegram Bot API itself. Empty means direct, which is what you
# want unless your host cannot reach Telegram at all — see README. Unlike
# MEDIA_PROXY this has no fallback: setting it makes the proxy a hard
# dependency for the whole bot, not just for audio.
# TELEGRAM_PROXY=
# MAX_CONCURRENT_JOBS=2      # simultaneous ffmpeg jobs across all users

# Per-user budgets on incoming requests; 0 switches one off. Admins are
# exempt. The first transcription of an episode is the expensive one — later
# searches on it are instant and not charged.
# RATE_INPUT_PER_MINUTE=20   # messages, buttons and inline queries
# RATE_CUTS_PER_HOUR=30
# RATE_ASR_PER_DAY=10        # first-time transcriptions

# Searching inside episodes. Transcription is minutes of CPU where a cut is
# seconds, so ASR_ENABLED=false stops it without stopping the bot.
# ASR_ENABLED=true
# ASR_BACKEND=local
# ASR_MODEL=base             # base is RTF 0.07 here; small is 0.23
# Search by meaning, not only by words: a converted multilingual-e5-small
# (CTranslate2 int8). Empty keeps search purely lexical.
# EMBED_MODEL_DIR=/data/models/multilingual-e5-small-ct2

# Cloud recognition (ASR_BACKEND=speechkit): a Yandex Cloud service-account
# API key with ai.speechkit-stt.user and the folder it lives in.
# SPEECHKIT_API_KEY=
# SPEECHKIT_FOLDER_ID=
# ASR_THREADS=8              # past this, scaling on this host is poor
# WORK_DIR=/tmp/podcast-cutter

# Durable state: the SQLite journal and rotating log files. Docker sets this
# to /data and mounts a volume there; without a mount, a redeploy loses both.
# DATA_DIR=data
# Journal rows older than this are deleted at startup. 0 keeps everything.
# LOG_RETENTION_DAYS=90
# Finished ASR queue rows contain Telegram/chat ids and expire sooner.
# ASR_JOB_RETENTION_HOURS=24
# Language, acceptance and recents for inactive users.
# USER_DATA_RETENTION_DAYS=365

# --- audio detour (optional) -------------------------------------------------
# Where some episodes are unfetchable from this server and fetchable from
# somewhere else, audio — and only audio — can be routed through a proxy there.
# Unset, everything below does nothing and fetches go direct. See deploy/README.md.
#
# One http:// URL; ffmpeg understands no other kind of proxy.
# MEDIA_PROXY=http://media-proxy:3128
# fallback: direct first, proxy only after a fetch fails the way a blocked
#           egress fails, so working episodes keep their route and latency.
# always:   proxy first, direct as the safety net.
# off:      kill switch that keeps the URL configured.
# MEDIA_PROXY_MODE=fallback
# Fetched through the proxy at startup to prove the route works.
# MEDIA_PROXY_PROBE_URL=https://traffic.megaphone.fm/

# The sidecar that carries the proxy into this compose network. Only started
# when the profile is enabled, so leaving these unset deploys the bot alone.
# COMPOSE_PROFILES=proxy
# TUNNEL_HOST=
# TUNNEL_PORT=44222
# TUNNEL_USER=me
# TUNNEL_REMOTE=127.0.0.1:3128
# TUNNEL_KEYS_DIR=/home/me/.podcast-cutter/tunnel

# --- offsite backup (optional) ----------------------------------------------
# Encrypted SQLCipher database (journal + transcripts) plus the complete .env,
# wrapped in an encrypted restic snapshot and sent to Yandex Disk. Inert
# unless the `backup` profile is run (scripts/backup.sh or the systemd timers
# in deploy/systemd). See docs/backup-policy.md for provisioning the rclone
# token and the restic password. NONE of these belong in git — .env is
# gitignored, and the restic password also lives in the user's Bitwarden.
#
# restic repository password. Lose it and the backup is unrecoverable.
# BACKUP_PASSWORD=
# restic repo behind rclone's native Yandex remote. `yadisk` is the remote
# name inside rclone.conf; the path is this stack's own directory.
# YANDEX_DISK_TARGET=rclone:yadisk:/backups/podcast-cutter
# Host staging dir on big-one for current/previous generations.
# BACKUP_STAGE=/srv/podcast-cutter-backup
# Host dir holding rclone.conf (mounted rw so rclone can persist OAuth tokens).
# BACKUP_RCLONE_DIR=/home/me/.podcast-cutter/rclone
# Retention: restic forget keep-daily / keep-weekly.
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# Optional gatus heartbeats — a missed push is caught as silence, so a failed
# push is not fatal. Weekly/monthly are for the maintenance timers.
# BACKUP_PUSH_URL=
# BACKUP_PUSH_URL_WEEKLY=
# BACKUP_PUSH_URL_MONTHLY=
# BACKUP_PUSH_TOKEN=
# TZ=Europe/Moscow
