# Telegram bot token from @BotFather
BOT_TOKEN=

# Podcast Index API credentials: https://api.podcastindex.org/signup
PODCAST_API_KEY=
PODCAST_API_SECRET=

# Optional. Defaults to the public Podcast Index endpoint.
PODCAST_API_BASEURL=https://api.podcastindex.org/api/1.0

# Telegram user ids allowed to run /stats, comma-separated. Unset means
# nobody. Send /stats once and the log will tell you your own id.
ADMIN_IDS=

# Optional tuning.
# MAX_CUT_SECONDS=900        # longest interval a user may request
# MAX_SOURCE_SECONDS=21600   # longest episode this bot will open at all
# MAX_CONCURRENT_JOBS=2      # simultaneous ffmpeg jobs across all users
# WORK_DIR=/tmp/podcast-cutter

# Durable state: the SQLite journal and rotating log files. Docker sets this
# to /data and mounts a volume there; without a mount, a redeploy loses both.
# DATA_DIR=data
# Journal rows older than this are deleted at startup. 0 keeps everything.
# LOG_RETENTION_DAYS=90

# --- audio detour (optional) -------------------------------------------------
# Where some episodes are unfetchable from this server and fetchable from
# somewhere else, audio — and only audio — can be routed through a proxy there.
# Unset, everything below does nothing and fetches go direct. See deploy/README.md.
#
# One http:// URL; ffmpeg understands no other kind of proxy.
# MEDIA_PROXY=http://media-proxy:3128
# fallback: direct first, proxy only after a fetch fails the way a blocked
#           egress fails, so working episodes keep their route and latency.
# always:   proxy first, direct as the safety net.
# off:      kill switch that keeps the URL configured.
# MEDIA_PROXY_MODE=fallback
# Fetched through the proxy at startup to prove the route works.
# MEDIA_PROXY_PROBE_URL=https://traffic.megaphone.fm/

# The sidecar that carries the proxy into this compose network. Only started
# when the profile is enabled, so leaving these unset deploys the bot alone.
# COMPOSE_PROFILES=proxy
# TUNNEL_HOST=
# TUNNEL_PORT=44222
# TUNNEL_USER=me
# TUNNEL_REMOTE=127.0.0.1:3128
# TUNNEL_KEYS_DIR=/home/me/.podcast-cutter/tunnel
