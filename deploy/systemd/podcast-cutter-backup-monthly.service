[Unit]
Description=podcast-cutter monthly full repository check and restore drill
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=me
UMask=0077
WorkingDirectory=/home/me/server/projects/podcast-cutter
ExecStart=/home/me/server/projects/podcast-cutter/scripts/restic-maintenance.sh monthly
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=2h
