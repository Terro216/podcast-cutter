[Unit]
Description=Daily podcast-cutter offsite backup

[Timer]
# 04:50, after cinemarr's 04:30 daily, so the two restic-over-rclone jobs do
# not contend for the shared Yandex token and the host's uplink at once.
OnCalendar=*-*-* 04:50:00 Europe/Moscow
RandomizedDelaySec=15min
Persistent=true
Unit=podcast-cutter-backup.service

[Install]
WantedBy=timers.target
