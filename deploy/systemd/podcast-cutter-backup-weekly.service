[Unit]
Description=podcast-cutter weekly restic prune and check
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=me
UMask=0077
WorkingDirectory=/home/me/server/projects/podcast-cutter
ExecStart=/home/me/server/projects/podcast-cutter/scripts/restic-maintenance.sh weekly
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=1h
